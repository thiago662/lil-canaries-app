rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Estar logado nunca basta: o Auth deixa qualquer um criar conta via API. Só entra quem tem
    // perfil em canarinhos/{uid}, e perfil só é criado pelo dono do projeto (console/seed), nunca
    // pelo cliente (ver `allow create` ausente abaixo).
    function isCanarinho() {
      return signedIn()
        && exists(/databases/$(database)/documents/canarinhos/$(request.auth.uid));
    }

    function isDono(uid) {
      return isCanarinho() && request.auth.uid == uid;
    }

    function validPerfil(d) {
      return d.keys().hasOnly(['nome', 'apelido', 'avatar'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 40
        && d.apelido is string && d.apelido.size() <= 30
        && d.avatar is string && d.avatar.size() > 0 && d.avatar.size() <= 10;
    }

    // mesmas faixas de TIPOS em src/app/core/medidas.ts, mantidas em sincronia à mão
    function validValor(tipo, v) {
      return v is number && (
        (tipo == 'peso' && v >= 20 && v <= 400)
        || (tipo == 'altura' && v >= 100 && v <= 250)
        || (tipo == 'salario' && v >= 0 && v <= 10000000)
        || (tipo == 'peca' && v >= 0 && v <= 100)
      );
    }

    // O id é `${tipo}_${data}`: um checkpoint por tipo e dia, e tipo/data nunca mudam num update.
    function validMedida(id, d) {
      return d.keys().hasOnly(['tipo', 'data', 'valor'])
        && d.keys().hasAll(['tipo', 'data', 'valor'])
        && d.tipo is string
        && d.data is string
        && d.data.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && id == d.tipo + '_' + d.data
        && validValor(d.tipo, d.valor);
    }

    // Meta de uma categoria (uma por tipo: o id é o tipo), com prazo opcional.
    function validMeta(id, d) {
      return d.keys().hasOnly(['tipo', 'valor', 'data'])
        && d.keys().hasAll(['tipo', 'valor'])
        && d.tipo is string
        && id == d.tipo
        && validValor(d.tipo, d.valor)
        && (!d.keys().hasAll(['data'])
            || (d.data is string
                && d.data.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')));
    }

    // Recado na ficha de alguém. Só create e delete (sem edição): o autor é quem escreve e a data
    // é a do servidor, então ninguém assina por outro nem inventa data.
    function validComentario(d) {
      return d.keys().hasOnly(['texto', 'autorUid', 'criadoEm'])
        && d.keys().hasAll(['texto', 'autorUid', 'criadoEm'])
        && d.texto is string && d.texto.size() >= 1 && d.texto.size() <= 200
        && d.autorUid == request.auth.uid
        && d.criadoEm == request.time;
    }

    // Apelido com M pro Marco. O id é o texto sem acento/maiúscula/símbolos (o cliente normaliza):
    // só `create` é permitido, então o mesmo apelido nunca é lançado duas vezes nem sobrescrito.
    function validApelido(id, d) {
      return d.keys().hasOnly(['texto', 'data', 'autorUid'])
        && d.keys().hasAll(['texto', 'data', 'autorUid'])
        && d.texto is string && d.texto.size() >= 2 && d.texto.size() <= 30
        && d.texto.matches('^[Mm].*')
        && d.data is string
        && d.data.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && d.autorUid == request.auth.uid
        && id.matches('^m[a-z0-9]{1,29}$');
    }

    match /apelidos/{id} {
      allow read: if isCanarinho();
      allow create: if isCanarinho() && validApelido(id, request.resource.data);
      allow delete: if isCanarinho() && resource.data.autorUid == request.auth.uid;
    }

    // Leitura de todos os checkpoints numa consulta só (collectionGroup('medidas')); também
    // vale pra ler os de um canarinho específico.
    match /{path=**}/medidas/{id} {
      allow read: if isCanarinho();
    }

    match /{path=**}/metas/{id} {
      allow read: if isCanarinho();
    }

    match /canarinhos/{uid} {
      allow read: if isCanarinho();
      allow update: if isDono(uid) && validPerfil(request.resource.data);

      match /medidas/{id} {
        allow create, update: if isDono(uid) && validMedida(id, request.resource.data);
        allow delete: if isDono(uid);
      }

      match /metas/{id} {
        allow create, update: if isDono(uid) && validMeta(id, request.resource.data);
        allow delete: if isDono(uid);
      }

      match /comentarios/{id} {
        allow read: if isCanarinho();
        allow create: if isCanarinho() && validComentario(request.resource.data);
        allow delete: if isCanarinho() && resource.data.autorUid == request.auth.uid;
      }
    }
  }
}
